<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- PROJECT INFORMATION -->
    <!-- ========================================================= -->

    <groupId>rest-assured-framework</groupId>
    <artifactId>rest-assured-framework</artifactId>
    <version>0.0.1-SNAPSHOT</version>


    <!-- ========================================================= -->
    <!-- PROPERTIES -->
    <!-- ========================================================= -->

    <properties>

        <!-- Java -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- Rest Assured -->
        <restassured.version>6.0.0</restassured.version>

        <!-- Jackson -->
        <jackson.version>2.21.0</jackson.version>

        <!-- Maven Surefire -->
        <surefire.version>3.5.4</surefire.version>

        <!-- Allure -->
        <allure.version>2.24.0</allure.version>

        <!-- Logging -->
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.4.11</logback.version>

        <!-- TestNG -->
        <testng.version>7.10.2</testng.version>

        <!-- Maven Plugins -->
        <compiler.version>3.13.0</compiler.version>
        <antrun.version>3.1.0</antrun.version>
        <exec.version>3.5.0</exec.version>

        <!-- Allure Archive Retention -->
        <allure.archive.retention.days>7</allure.archive.retention.days>

        <!-- Encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    </properties>


    <!-- ========================================================= -->
    <!-- DEPENDENCIES -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- ===================================================== -->
        <!-- REST ASSURED -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- TESTNG -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- JACKSON -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- LOGGING -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>


        <!-- ===================================================== -->
        <!-- ALLURE TESTNG -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- ALLURE REST ASSURED -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- JSON SCHEMA VALIDATOR -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${restassured.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- JAVA FAKER -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.github.javafaker</groupId>
            <artifactId>javafaker</artifactId>
            <version>1.0.2</version>
        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- BUILD -->
    <!-- ========================================================= -->

    <build>

        <plugins>


            <!-- ================================================= -->
            <!-- MAVEN COMPILER -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.version}</version>

                <configuration>
                    <release>17</release>
                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- MAVEN SUREFIRE -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>

                <configuration>

                    <useModulePath>false</useModulePath>

                    <!-- TestNG Suite -->
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>

                    <!-- TestNG Group Filtering -->
                    <!--suppress UnresolvedMavenProperty -->
                    <groups>${groups}</groups>

                    <!-- Allure Results -->
                    <systemPropertyVariables>

                        <allure.results.directory>
                            ${project.build.directory}/allure-results
                        </allure.results.directory>

                    </systemPropertyVariables>

                    <!-- Continue execution even when tests fail -->
                    <testFailureIgnore>true</testFailureIgnore>

                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- ALLURE CLI GENERATOR -->
            <!-- ================================================= -->
            <!--
                IMPORTANT:

                We intentionally DO NOT use allure-maven.

                Allure CLI generates the report so that the
                framework-generated executor.json is preserved.
            -->

            <plugin>

                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.version}</version>

                <executions>

                    <execution>

                        <id>generate-allure-report</id>

                        <phase>verify</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>

                            <!-- Allure CLI must be available in PATH -->
                            <executable>allure</executable>

                            <arguments>

                                <!-- Generate -->
                                <argument>generate</argument>

                                <!-- Input -->
                                <argument>
                                    ${project.build.directory}/allure-results
                                </argument>

                                <!-- Output -->
                                <argument>-o</argument>

                                <argument>
                                    ${project.build.directory}/allure-report
                                </argument>

                                <!-- Clean generated report -->
                                <argument>--clean</argument>

                            </arguments>

                        </configuration>

                    </execution>

                </executions>

            </plugin>


            <!-- ================================================= -->
            <!-- ALLURE HISTORY + REPORT ARCHIVER + RETENTION -->
            <!-- ================================================= -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${antrun.version}</version>

                <executions>


                    <!-- ========================================= -->
                    <!-- STEP 1: RESTORE PREVIOUS HISTORY -->
                    <!-- ========================================= -->

                    <execution>

                        <id>restore-allure-history</id>

                        <!--
                            clean removes target/.

                            Therefore restore the permanent
                            Allure history before tests execute.
                        -->

                        <phase>process-test-resources</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>

                            <target>

                                <echo>
                                    ==========================================
                                    Restoring previous Allure history...
                                    ==========================================
                                </echo>


                                <!-- Make sure results directory exists -->
                                <mkdir
                                        dir="${project.build.directory}/allure-results"/>


                                <!-- Restore saved history -->
                                <copy
                                        todir="${project.build.directory}/allure-results/history"
                                        overwrite="true"
                                        failonerror="false">

                                    <fileset
                                            dir="${project.basedir}/allure-history/history"
                                            erroronmissingdir="false"/>

                                </copy>


                                <echo>
                                    Previous Allure history restored.
                                </echo>

                            </target>

                        </configuration>

                    </execution>


                    <!-- ========================================= -->
                    <!-- STEP 2: SAVE HISTORY + ARCHIVE + CLEANUP -->
                    <!-- ========================================= -->

                    <execution>

                        <id>save-history-and-archive-report</id>

                        <!--
                            Runs during verify.

                            By this point:

                            1. Tests are finished.
                            2. Allure CLI generated the report.
                            3. target/allure-report exists.

                            Then we:

                            4. Save updated history.
                            5. Archive today's report.
                            6. Remove expired archives.
                        -->

                        <phase>verify</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>

                            <target>


                                <!-- ================================= -->
                                <!-- GENERATE ARCHIVE DATE -->
                                <!-- ================================= -->

                                <tstamp>

                                    <format
                                            property="archive.date"
                                            pattern="yyyy-MM-dd"/>

                                </tstamp>


                                <!-- ================================= -->
                                <!-- SAVE UPDATED HISTORY -->
                                <!-- ================================= -->

                                <echo>
                                    ==========================================
                                    Saving updated Allure history...
                                    ==========================================
                                </echo>


                                <!-- Ensure permanent history exists -->
                                <mkdir
                                        dir="${project.basedir}/allure-history/history"/>


                                <!--
                                    Copy newly generated history from
                                    the current Allure report into
                                    permanent storage.
                                -->

                                <copy
                                        todir="${project.basedir}/allure-history/history"
                                        overwrite="true"
                                        failonerror="false">

                                    <fileset
                                            dir="${project.build.directory}/allure-report/history"
                                            erroronmissingdir="false"/>

                                </copy>


                                <echo>
                                    Updated Allure history saved.
                                </echo>


                                <!-- ================================= -->
                                <!-- CREATE DATED REPORT ARCHIVE -->
                                <!-- ================================= -->

                                <echo>
                                    ==========================================
                                    Creating dated Allure report archive...
                                    ==========================================
                                </echo>


                                <!-- Create today's archive directory -->
                                <!--suppress UnresolvedMavenProperty -->
                                <mkdir
                                        dir="${project.basedir}/reports/allure/${archive.date}"/>


                                <!--
                                    Copy the complete generated
                                    Allure report into today's archive.
                                -->

                                <!--suppress UnresolvedMavenProperty -->
                                <copy
                                        todir="${project.basedir}/reports/allure/${archive.date}"
                                        overwrite="true"
                                        failonerror="true">

                                    <fileset
                                            dir="${project.build.directory}/allure-report"/>

                                </copy>


                                <echo>
                                    ==========================================
                                    Allure report archived successfully.
                                    ==========================================
                                </echo>


                                <!--suppress UnresolvedMavenProperty -->
                                <echo>
                                    Archive:
                                    ${project.basedir}/reports/allure/${archive.date}
                                </echo>


                                <!-- ================================= -->
                                <!-- CLEANUP EXPIRED ARCHIVES -->
                                <!-- ================================= -->

                                <echo>
                                    ==========================================
                                    Cleaning expired Allure archives...
                                    ==========================================
                                </echo>


                                <!--
                                    Call the framework's Java cleanup
                                    utility after the current report
                                    has already been archived.

                                    Retention is controlled by:

                                    ${allure.archive.retention.days}
                                -->

                                <java
                                        classname="com.cheq.application.utilities.AllureReportArchiveManager"
                                        fork="true"
                                        failonerror="true">

                                    <classpath>

                                        <!--
                                            The cleanup manager is compiled
                                            into target/classes.
                                        -->

                                        <pathelement
                                                location="${project.build.outputDirectory}"/>

                                        <pathelement
                                                location="${project.build.testOutputDirectory}"/>

                                    </classpath>


                                    <!--
                                        Pass configured retention days
                                        to AllureReportArchiveManager.
                                    -->

                                    <arg
                                            value="${allure.archive.retention.days}"/>

                                </java>


                                <echo>
                                    ==========================================
                                    Allure archive cleanup completed.
                                    ==========================================
                                </echo>


                            </target>

                        </configuration>

                    </execution>


                </executions>

            </plugin>


        </plugins>

    </build>

</project>