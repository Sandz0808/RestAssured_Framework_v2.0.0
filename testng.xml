<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Contact List API Automation"
       verbose="1">
<!--       parallel="none">-->

    <!-- ===================================================== -->
    <!-- LISTENERS -->
    <!-- ===================================================== -->
    <listeners>

        <!-- Retry Mechanism -->
        <listener class-name="com.cheq.contactlist.listeners.RetryTransformer"/>


    </listeners>

    <!-- ===================================================== -->
    <!-- MAIN EXECUTION -->
    <!-- ===================================================== -->

    <test name="API Test Suite">


        <!-- ================================================ -->
        <!-- PACKAGE SCAN -->
        <!-- Automatically discovers all tests -->
        <!-- ================================================ -->

        <packages>

            <package name="com.cheq.contactlist.tests.examplebasic"/>
            <package name="com.cheq.contactlist.tests.e2e"/>
            <package name="com.cheq.contactlist.tests.usermanagement"/>
            <package name="com.cheq.contactlist.tests.contactmanagement"/>

        </packages>

    </test>

</suite>