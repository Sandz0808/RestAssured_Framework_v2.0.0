{
  "$schema": "https://json-schema.org/draft-07/schema#",

  "type": "object",

  "properties": {

    "token": {
      "type": "string"
    },

    "user": {

      "type": "object",

      "properties": {

        "_id": {
          "type": "string"
        },

        "firstName": {
          "type": "string"
        },

        "lastName": {
          "type": "string"
        },

        "email": {
          "type": "string"
        }

      },

      "required": [
        "_id",
        "firstName",
        "lastName",
        "email"
      ]

    }

  },

  "required": [
    "token",
    "user"
  ]
}